---
import ProductCard from './ProductCard.astro';
import type { Product } from '../lib/products';

interface Props {
  products: Product[];
  eagerCount?: number;
  id?: string;
}
const { products, eagerCount = 0, id } = Astro.props;
---

<ul class="grid" id={id}>
  {products.map((p, i) => <ProductCard product={p} eager={i < eagerCount} />)}
</ul>
