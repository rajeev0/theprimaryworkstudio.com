---
import { SITE } from '../site';
import { getProducts } from '../lib/products';

const products = await getProducts();
const hasFreebies = products.some((p) => p.data.isFree);
const hasBundles = products.some((p) => p.data.isBundle);

const nav = [
  { href: '/shop/', label: 'Shop' },
  ...(hasBundles ? [{ href: '/bundles/', label: 'Bundles' }] : []),
  ...(hasFreebies ? [{ href: '/freebies/', label: 'Freebies' }] : []),
  { href: '/fun-and-games/', label: 'Fun & Games' },
  { href: '/about/', label: 'About' },
];
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/" aria-label={`${SITE.name}, home`}>
      <!-- Logo files are used as supplied: never recoloured, stretched or cropped. -->
      <picture class="brand__badge">
        <source media="(min-width: 48em)" srcset="/brand/badge_full.svg" />
        <img src="/brand/badge_icon.svg" alt="" width="300" height="300" />
      </picture>
      <span class="brand__text">
        <span class="brand__name">{SITE.name}</span>
        <span class="brand__tagline">{SITE.tagline}</span>
      </span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          nav.map((n) => (
            <li>
              <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
    background: var(--cream);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    flex-wrap: wrap;
    padding-block: 0.75rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }
  /* Clear space: padding = 1/10 of the badge width on every side. */
  .brand__badge {
    --badge: 3rem;
    flex: none;
    padding: calc(var(--badge) / 10);
  }
  .brand__badge img {
    width: var(--badge);
    height: var(--badge);
  }
  @media (min-width: 48em) {
    .brand__badge {
      --badge: 5rem;
    }
  }
  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .brand__name {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(1.1rem, 2.6vw, 1.4rem);
    color: var(--sage);
  }
  .brand__tagline {
    font-family: var(--font-head);
    font-weight: 500;
    font-size: 0.9rem;
    color: var(--terracotta-ink);
  }
  nav ul {
    display: flex;
    gap: 0.25rem 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }
  nav a {
    font-family: var(--font-head);
    font-weight: 700;
    text-decoration: none;
    padding: 0.4rem 0.1rem;
    border-bottom: 2px solid transparent;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    border-bottom-color: var(--terracotta);
    color: var(--sage);
  }
</style>
